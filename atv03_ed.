3. Crie um TAD que implemente o controle de uma conta bancaria, implemente funções para inicializar, deposito, sacar e imprimir o saldo.


#include <stdio.h>
#include <stdlib.h>
//incluindo bibliotecas

typedef struct {
    int numero;
    float saldo;
} conta;

void inicializar(conta *c, int numero) {
    c -> numero = numero;
    c -> saldo = 0;
}

void depositar(conta *c, float valor) {
    c -> saldo += valor;
}

void sacar(conta *c, float valor) {
    if(valor <= c->saldo) {
        c -> saldo -= valor;
    } else {
        printf("Saldo insuficiente\n");
    }
}

//imprimindo o saldo bancário..
void imprimirSaldo(conta *c) {
    printf("Saldo da conta: %.2f\n", c -> saldo);
}
