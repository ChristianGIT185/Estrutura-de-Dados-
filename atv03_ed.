4. Utilizando a alocação dinamica de memoria crie uma função para criar uma nova conta bancaria.

Conta* criarConta(int numero) {

    Conta *c;

    c = (Conta*) malloc(sizeof(Conta)); //alocação dinamica o tamanho de Conta

    if(c != NULL) {
        c->numero = numero;
        c->saldo = 0;
    }

    return c;
}

int main() {

    Conta *c1;

    c1 = criarConta(1);

    depositar(c1, 1000);
    sacar(c1, 300);
    imprimirSaldo(c1);

    return 0;
}




